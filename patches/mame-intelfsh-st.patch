+class st_m28w320ect_device : public intelfsh16_device
+{
+public:
+	st_m28w320ect_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock = 0);
+	// Qualified low-voltage VPP input, not an analogue voltage or VPPH model.
+	void vpp_valid_w(int state) { m_vpp_valid = bool(state); }
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+	virtual void nvram_default() override;
+	virtual bool nvram_read(util::read_stream &file) override;
+	virtual bool nvram_write(util::write_stream &file) override;
+	virtual uint32_t read_full(uint32_t address) override;
+	virtual void write_full(uint32_t address, uint32_t data) override;
+
+private:
+	enum setup_state : uint8_t
+	{
+		SETUP_IDLE = 0, SETUP_WORD = 1, SETUP_ERASE = 2, SETUP_LOCK = 3,
+		SETUP_DOUBLE_FIRST = 4, SETUP_DOUBLE_SECOND = 5,
+		SETUP_QUAD_FIRST = 6, SETUP_QUAD_SECOND = 7,
+		SETUP_QUAD_THIRD = 8, SETUP_QUAD_FOURTH = 9, SETUP_OTP = 10
+	};
+	bool collect_program_data(uint32_t address, uint16_t data);
+	unsigned block(uint32_t address) const;
+	uint8_t protection(unsigned index) const;
+	void update_status();
+	bool check_vpp();
+	void start_program(unsigned words);
+	void start_otp_program(uint32_t address, uint16_t data);
+	TIMER_CALLBACK_MEMBER(operation_complete);
+
+	std::array<uint8_t, 71> m_st_locks{};
+	std::array<uint16_t, 13> m_st_otp{}, m_st_otp_seed{};
+	bool m_st_otp_dirty = false;
+	bool m_program_otp = false;
+	bool m_vpp_valid = true;
+	std::array<uint32_t, 4> m_program_address{};
+	std::array<uint16_t, 4> m_program_data{};
+	uint8_t m_setup = SETUP_IDLE;
+	uint8_t m_program_words = 0;
+	bool m_program_active = false;
