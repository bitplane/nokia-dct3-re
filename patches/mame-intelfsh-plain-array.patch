 };
 
 
@@ -109,6 +110,14 @@
 public:
 	// public interface
 	uint16_t read(offs_t offset) { return read_full(offset); }
+
+	// The array, high byte of each word first, while read() would return it
+	// unmodified; otherwise null. Valid only until the next write or timer.
+	uint8_t const *plain_array() const
+	{
+		return (m_plain_array && m_flash_mode == 0 /* FM_NORMAL */ && m_bank == 0) ? m_data.get() : nullptr;
+	}
+
 	void write(offs_t offset, uint16_t data) { write_full(offset, data); }
 
 	uint16_t read_raw(offs_t offset) { return m_data[offset*2] | (m_data[offset*2+1] << 8); }
