+void nand_device::ce_w(int state)
+{
+	if (state && !m_ce && m_block_sequential_read && m_mode == SM_M_READ)
+		m_read_exhausted = true;
+	m_ce = bool(state);
+}
+
+void nand_device::start_operation(u8 operation, attotime duration)
+{
+	m_pending_operation = operation;
+	m_status &= ~0x40;
+	m_write_rnb(0);
+	if (duration.is_zero())
+		operation_complete(0);
+	else
+		m_operation_timer->adjust(duration);
+}
+
+TIMER_CALLBACK_MEMBER(nand_device::operation_complete)
+{
+	if (m_pending_operation == OP_PROGRAM)
+	{
+		if (m_page_addr < m_num_pages)
+			for (u32 i = 0; i < m_page_total_size; ++i)
+				m_feeprom_data[m_page_addr * m_page_total_size + i] &= m_pagereg[i];
+		else
+			m_status |= 1;
+	}
+	else if (m_pending_operation == OP_ERASE)
+	{
+		if (m_page_addr < m_num_pages)
+		{
+			u32 const first = m_page_addr & ~((1U << m_log2_pages_per_block) - 1);
+			std::fill_n(m_feeprom_data.get() + first * m_page_total_size,
+					(1U << m_log2_pages_per_block) * m_page_total_size, 0xff);
+		}
+		else
+			m_status |= 1;
+	}
+	m_pending_operation = 0;
+	m_status |= 0x40;
+	m_write_rnb(1);
+}
