+DEFINE_DEVICE_TYPE(SED1565, sed1565_device, "sed1565", "Epson SED1565 LCD Driver")
 
 
+// SED1565 series datasheet, rev. 1.2: serial interface and commands, pp. 8-24, 8-48..8-56.
+// Analog contrast, supply ramp/busy timing and the separate static indicator output are not rendered.
+sed1565_device::sed1565_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock)
+	: sed15xx_device_base(mconfig, SED1565, tag, owner, clock, 132 * 9, 132)
+{
+}
+
+void sed1565_device::set_panel_window(uint8_t segment, uint8_t width, uint8_t height)
+{
+	if (!width || !height || unsigned(segment) + width > 132 || height > 65)
+		fatalerror("SED1565: invalid panel window");
+	m_panel_segment = segment;
+	m_panel_width = width;
+	m_panel_height = height;
+}
+
+void sed1565_device::device_start()
+{
+	sed15xx_device_base::device_start();
+	save_item(NAME(m_sdin)); save_item(NAME(m_sclk)); save_item(NAME(m_dc));
+	save_item(NAME(m_cs)); save_item(NAME(m_reset));
+	save_item(NAME(m_shift)); save_item(NAME(m_bits));
+	save_item(NAME(m_reverse)); save_item(NAME(m_fill)); save_item(NAME(m_com_reverse));
+	save_item(NAME(m_pending)); save_item(NAME(m_volume)); save_item(NAME(m_bias));
+	save_item(NAME(m_power)); save_item(NAME(m_resistor));
+	save_item(NAME(m_static_mode)); save_item(NAME(m_static_on));
+}
+
+void sed1565_device::reset_registers()
+{
+	m_start_line = m_column = m_page = m_old_column = 0;
+	m_pending = m_resistor = m_static_mode = 0;
+	m_modify_write = m_com_reverse = m_static_on = false;
+	m_volume = 0x20;
+}
+
+void sed1565_device::device_reset()
+{
+	sed15xx_device_base::device_reset();
+	reset_registers();
+	m_lcd_on = m_adc = 0;
+	m_shift = m_bits = m_bias = m_power = 0;
+	m_reverse = m_fill = false;
+	m_sdin = m_sclk = m_dc = m_cs = false;
+	m_reset = true;
+}
+
+void sed1565_device::reset_w(int state)
+{
+	if (!state && m_reset)
+	{
+		reset_registers();
+		m_lcd_on = m_adc = 0;
+		m_reverse = m_fill = false;
+		m_bias = m_power = m_shift = m_bits = 0;
+	}
+	m_reset = bool(state);
+}
+
+void sed1565_device::cs_w(int state)
+{
+	m_cs = bool(state);
+	if (m_cs)
+		m_bits = m_shift = 0;
+}
+
+void sed1565_device::sclk_w(int state)
+{
+	if (state && !m_sclk && !m_cs && m_reset)
+	{
+		m_shift = (m_shift << 1) | m_sdin;
+		if (++m_bits == 8)
+		{
+			if (m_dc) data_write(m_shift);
+			else control_write(m_shift);
+			m_bits = m_shift = 0;
+		}
+	}
+	m_sclk = bool(state);
+}
+
+void sed1565_device::increment_column()
+{
+	// The counter saturates at 83h; it never carries into the page address.
+	if (m_column < 131)
+		++m_column;
+}
+
+void sed1565_device::data_write(uint8_t data)
+{
+	if (m_column >= 132 || m_page > 8)
+		return;
+	m_ddr[m_page * 132 + m_column] = m_page == 8 ? data & 1 : data;
+	increment_column();
+}
+
+uint8_t sed1565_device::data_read()
+{
+	uint8_t const result = m_data;
+	if (!machine().side_effects_disabled() && m_column < 132 && m_page <= 8)
+	{
+		m_data = m_ddr[m_page * 132 + m_column];
+		if (!m_modify_write) increment_column();
+	}
+	return result;
+}
+
+uint8_t sed1565_device::status_read()
+{
+	return (m_busy << 7) | ((!m_adc) << 6) | ((!m_lcd_on) << 5) | ((!m_reset) << 4);
+}
+
+void sed1565_device::control_write(uint8_t data)
+{
+	if (m_pending)
+	{
+		if (m_pending == 0x81) m_volume = data & 0x3f;
+		else m_static_mode = data & 3;
+		m_pending = 0;
+	}
+	else if ((data & 0xfe) == 0xae) m_lcd_on = BIT(data, 0);
+	else if ((data & 0xc0) == 0x40) m_start_line = data & 0x3f;
+	else if ((data & 0xf0) == 0xb0) m_page = data & 0x0f;
+	else if ((data & 0xf0) == 0x00) m_column = (m_column & 0xf0) | (data & 0x0f);
+	else if ((data & 0xf0) == 0x10) m_column = (m_column & 0x0f) | ((data & 0x0f) << 4);
+	else if ((data & 0xfe) == 0xa0) m_adc = BIT(data, 0);
+	else if ((data & 0xfe) == 0xa6) m_reverse = BIT(data, 0);
+	else if ((data & 0xfe) == 0xa4) m_fill = BIT(data, 0);
+	else if ((data & 0xfe) == 0xa2) m_bias = BIT(data, 0);
+	else if ((data & 0xf0) == 0xc0) m_com_reverse = BIT(data, 3);
+	else if ((data & 0xf8) == 0x28) m_power = data & 7;
+	else if ((data & 0xf8) == 0x20) m_resistor = data & 7;
+	else if (data == 0x81) m_pending = data;
+	else if ((data & 0xfe) == 0xac)
+	{
+		m_static_on = BIT(data, 0);
+		if (m_static_on) m_pending = data;
+	}
+	else if (data == 0xe0) { m_modify_write = true; m_old_column = m_column; }
+	else if (data == 0xee) { m_modify_write = false; m_column = m_old_column; }
+	else if (data == 0xe2) reset_registers(); // Software reset preserves display RAM.
+	else if (data != 0xe3 && data != 0xf0)
+		logerror("%s: unsupported SED1565 command %02x\n", machine().describe_context(), data);
+}
+
+uint32_t sed1565_device::screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect)
+{
+	bitmap.fill(0, cliprect);
+	if (!m_lcd_on) return 0;
+	for (int y = std::max(0, cliprect.top()); y <= std::min(int(m_panel_height) - 1, cliprect.bottom()); ++y)
+	{
+		// COMS is the separate 65th row, not part of the 64-line start-line rotation.
+		unsigned const row = y == 64 ? 64 : (m_start_line + (m_com_reverse ? 63 - y : y)) & 63;
+		for (int x = std::max(0, cliprect.left()); x <= std::min(int(m_panel_width) - 1, cliprect.right()); ++x)
+		{
+			unsigned const segment = m_panel_segment + x;
+			unsigned const column = m_adc ? 131 - segment : segment;
+			bool const pixel = BIT(m_ddr[(row / 8) * 132 + column], row & 7);
+			bitmap.pix(y, x) = m_fill || (pixel != m_reverse);
+		}
+	}
+	return 0;
+}
