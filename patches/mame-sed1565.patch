+// ======================> sed1565_device
+
+class sed1565_device : public sed15xx_device_base
+{
+public:
+	sed1565_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock = 0);
+	void set_panel_window(uint8_t segment, uint8_t width, uint8_t height);
+	void sdin_w(int state) { m_sdin = bool(state); }
+	void dc_w(int state) { m_dc = bool(state); }
+	void sclk_w(int state);
+	void cs_w(int state);
+	void reset_w(int state);
+	virtual void control_write(uint8_t data) override;
+	virtual void data_write(uint8_t data) override;
+	virtual uint8_t data_read() override;
+	virtual uint8_t status_read() override;
+	uint32_t screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect);
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+
+private:
+	void reset_registers();
+	void increment_column();
+	uint8_t m_panel_segment = 0;
+	uint8_t m_panel_width = 132;
+	uint8_t m_panel_height = 65;
+	bool m_sdin = false, m_sclk = false, m_dc = false, m_cs = false, m_reset = true;
+	uint8_t m_shift = 0, m_bits = 0;
+	bool m_reverse = false, m_fill = false, m_com_reverse = false;
+	uint8_t m_pending = 0, m_volume = 0x20, m_bias = 0, m_power = 0, m_resistor = 0;
+	uint8_t m_static_mode = 0;
+	bool m_static_on = false;
+};
