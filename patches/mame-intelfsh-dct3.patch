+void intelfsh_device::device_reset()
+{
+	if (m_flexible_block_lock)
+	{
+		m_block_locks.fill(1);
+		m_status = 0x80;
+		m_flash_mode = FM_NORMAL;
+		m_timer->adjust(attotime::never);
+	}
+}
+
+unsigned intelfsh_device::lock_index(uint32_t address) const
+{
+	uint32_t const byte_address = (address * 2) % m_size;
+	uint32_t const span = m_parameter_block_size * m_parameter_block_count;
+	bool const parameter = (m_top_boot_sector && byte_address >= m_size - span)
+			|| (m_bot_boot_sector && byte_address < span);
+	uint32_t const size = parameter ? m_parameter_block_size : m_main_block_size;
+	return (byte_address & ~(size - 1)) / m_parameter_block_size;
+}
