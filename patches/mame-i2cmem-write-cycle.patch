 				LOGMASKED( LOG_STATE, "%s: I2C stop\n", machine().describe_context() );
 				m_state = STATE_IDLE;
@@ -390,7 +425,12 @@ void i2cmem_device::write_scl(int state)
 						case STATE_DEVSEL:
