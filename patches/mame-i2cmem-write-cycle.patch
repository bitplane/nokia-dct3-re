+	m_write_cycle_time(attotime::zero),
+	m_write_cycle_timer(nullptr),
+	m_write_busy(false),
 	m_devsel_address_low(false)
 {
 	// these memories work off the I2C clock only
@@ -205,6 +209,7 @@ void i2cmem_device::device_start()
 {
 	m_data = std::make_unique<uint8_t []>(m_data_size);
 	m_page.resize( m_write_page_size );
+	m_write_cycle_timer = timer_alloc(FUNC(i2cmem_device::write_cycle_complete), this);
 
 	save_item( NAME(m_scl) );
 	save_item( NAME(m_sdaw) );
@@ -222,6 +227,8 @@ void i2cmem_device::device_start()
 	save_item( NAME(m_byteaddr) );
 	save_item( NAME(m_page_offset) );
 	save_item( NAME(m_page_written_size) );
+	save_item( NAME(m_write_base) );
+	save_item( NAME(m_write_busy) );
 	save_pointer( &m_data[0], "m_data", m_data_size );
 	if ( m_write_page_size > 0 )
 	{
@@ -229,6 +236,33 @@ void i2cmem_device::device_start()
 	}
 }
 
+void i2cmem_device::device_reset()
+{
+	m_write_cycle_timer->adjust(attotime::never);
+	m_write_busy = false;
+	m_page_written_size = 0;
+}
+
+void i2cmem_device::commit_page()
+{
+	if (!m_page_written_size)
+		return;
+
+	int const root = m_write_base & ~(m_write_page_size - 1);
+	for (int i = 0; i < m_page_written_size; i++)
+		m_data[root | ((m_write_base + i) & (m_write_page_size - 1))] = m_page[i];
+	LOGMASKED(LOG_STATE, "EEPROM data[ %04x to %04x ] = %x bytes\n",
+			m_write_base, root | ((m_write_base + m_page_written_size - 1) & (m_write_page_size - 1)),
+			m_page_written_size);
+	m_page_written_size = 0;
+}
+
+TIMER_CALLBACK_MEMBER(i2cmem_device::write_cycle_complete)
+{
+	commit_page();
+	m_write_busy = false;
+}
+
 
