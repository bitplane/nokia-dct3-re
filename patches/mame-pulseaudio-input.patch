+void sound_pulse::i_stream_read_request(pa_stream *, size_t, void *self)
+{
+	reinterpret_cast<stream_info *>(self)->m_pulse->stream_read_request(
+			reinterpret_cast<stream_info *>(self));
+}
+
+void sound_pulse::stream_read_request(stream_info *stream)
+{
+	const void *data = nullptr;
+	size_t bytes = 0;
+	if (pa_stream_peek(stream->m_stream, &data, &bytes) < 0)
+		return;
+
+	if (data && bytes)
+		stream->m_buffer.push(
+				reinterpret_cast<const int16_t *>(data),
+				bytes / (sizeof(int16_t) * stream->m_channels));
+	pa_stream_drop(stream->m_stream);
+}
