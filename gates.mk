# Generated by tools/gate_generate.py — do not edit.
#
# Acceptance gates for the Nokia DCT3 driver. Each gate runs a firmware session
# under MAME and checks the resulting trace. Regenerate with `make gates`.
#
# A gate marked "shell" below still carries its recipe verbatim: its control
# flow is not yet modelled by the gate matrix, so it is copied rather than
# rebuilt. Those are the remaining migration work.

# 199 gates: 138 generated from typed steps, 61 copied verbatim (shell).

# Shell guards shared by gates that rewrite provisioned state.
#
# Deferred (`=`), not immediate (`:=`). The guard names
# $(EEPROM_BASENAME), which itself selects a filename from $(BIOS), and
# gates set BIOS per target. Expanding at definition time would freeze
# the default revision's EEPROM into every gate, so a v5.01 gate would
# restore the v6.00 file.

DCT3_EEPROM_GUARD = restore_default() { $(MAKE) --no-print-directory eeprom-profile; cp "roms/noki3210/$(EEPROM_BASENAME)" "$(MAME_DIR)/roms/noki3210/$(EEPROM_BASENAME)"; }; trap restore_default EXIT;
DCT3_EEPROM_GUARD_V501 = restore_default() { $(MAKE) --no-print-directory eeprom-profile BIOS=501 ROM=roms/nokia_3210_nse-8_v05_01_full_hu.fls; cp "roms/noki3210/3210 v501 eeprom.bin" "$(MAME_DIR)/roms/noki3210/3210 v501 eeprom.bin"; }; trap restore_default EXIT;

# Product run identities: which handset and firmware a gate runs.

DCT3_RUN_3210_V501 := PHONE=noki3210 BIOS=501
DCT3_RUN_3310      := PHONE=noki3310 BIOS=639
DCT3_RUN_3330      := PHONE=noki3330 BIOS=450e
DCT3_RUN_3410      := PHONE=noki3410 BIOS=546e
DCT3_RUN_3210      := PHONE=noki3210

# Key press shapes, named by value. A DURATION setting with no
# paired GAP is a different shape and is left inline.

DCT3_PRESS_70_180  := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=70 NOKIA_DCT3_POST_READY_KEY_GAP_MS=180
DCT3_PRESS_70_200  := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=70 NOKIA_DCT3_POST_READY_KEY_GAP_MS=200
DCT3_PRESS_120_240 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=120 NOKIA_DCT3_POST_READY_KEY_GAP_MS=240
DCT3_PRESS_180_300 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=180 NOKIA_DCT3_POST_READY_KEY_GAP_MS=300
DCT3_PRESS_200_200 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=200 NOKIA_DCT3_POST_READY_KEY_GAP_MS=200
DCT3_PRESS_200_280 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=200 NOKIA_DCT3_POST_READY_KEY_GAP_MS=280
DCT3_PRESS_200_300 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=200 NOKIA_DCT3_POST_READY_KEY_GAP_MS=300
DCT3_PRESS_220_280 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=220 NOKIA_DCT3_POST_READY_KEY_GAP_MS=280
DCT3_PRESS_220_300 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=220 NOKIA_DCT3_POST_READY_KEY_GAP_MS=300
DCT3_PRESS_220_350 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=220 NOKIA_DCT3_POST_READY_KEY_GAP_MS=350
DCT3_PRESS_240_350 := NOKIA_DCT3_POST_READY_KEY_DURATION_MS=240 NOKIA_DCT3_POST_READY_KEY_GAP_MS=350

