# ── Copyrighted firmware / dumps — NEVER commit (bring your own; see roms/README.md) ──
*.fls
*.bin
*.rom
roms/**
!roms/README.md
# swap16 / extracted firmware images
*swap16*

# ── Third-party proprietary tools / their reverse-engineering — do not redistribute ──
NokTool*.exe
nok.exe
noktool*.zip
noktool-src/
*.rar
idr/

# ── Derived-from-firmware artifacts (decompiled output is a derivative work) ──
ghidra_out/
ghidra/decompiled*/
**/decompiled*/
*.idc
*.idp
*.lst

# ── Generated build / analysis state ──
mame/
.venv/
venv/
run_*/
run_*.log
/run-*/
!tools/run_manifests/
!tools/run_manifests/*.json
run/
cfg/
nvram/
snap/
progress_latest_frame.*
*.pgm
scratchpad/
/tmp/
third_party/libgsm-*/
third_party/*.tar.gz

# ── Editor / OS noise ──
__pycache__/
*.pyc
.DS_Store

# runtime artifact (stray mame log in repo root)
*.log
*.trace
*.wav
*.raw
*.state
capture/
captures/

# ad-hoc message-topology census outputs (canonical conclusions live in docs/)
run_*_events.json
run_*_events.txt

# MAME writes a default configuration beside named negative-network fixtures.
fixtures/radio_cell_barred/default.cfg
fixtures/radio_cell_rxlev/default.cfg
fixtures/radio_assignment_mismatch/default.cfg
fixtures/radio_disabled/default.cfg
fixtures/radio_paging_wrong_group/default.cfg
fixtures/radio_paging_unmatched/default.cfg
fixtures/radio_paging_malformed/default.cfg
fixtures/radio_paging_unsuitable/default.cfg
